---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/style.css";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  published?: string;
  activeNav?: "home" | "library" | "contact";
  bodyClass?: string;
}

const siteName = "IMPACT Recap";
const defaultTitle = `${siteName} | Sermon Summaries, Verses, and Plans`;
const defaultDescription =
  "Missed an Impact Church sermon? Impact Recap has the summary, main points, verses, and a six-day action plan, plus the full message to watch.";
const defaultImage = "/og.jpg";

const {
  title,
  description = defaultDescription,
  image = defaultImage,
  imageAlt,
  ogType = "website",
  published,
  activeNav,
  bodyClass,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteName}` : defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const socialImageAlt = imageAlt ?? title ?? siteName;
const usesDefaultImage = image === defaultImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.jpg" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {usesDefaultImage && <meta property="og:image:width" content="1200" />}
    {usesDefaultImage && <meta property="og:image:height" content="630" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,600&display=swap" rel="stylesheet" />
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header id="top">
      <div class="container">
        <div class="align-items-center">
          <a class="impact-brand-link" href="/">
            <p class="impact-brand-title">IMPACT Recap</p>
          </a>
        </div>
      </div>
      <Nav active={activeNav} />
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer />

    <a href="#top" class="back-to-top" aria-label="Back to top"><i class="fa fa-chevron-up" aria-hidden="true"></i></a>

    <script src="../scripts/site.ts"></script>
  </body>
</html>
