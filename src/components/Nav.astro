---
interface Props {
  active?: "home" | "library" | "contact";
}
const { active } = Astro.props;
const cls = (key: Props["active"]) => `nav-item nav-link${active === key ? " active" : ""}`;
const current = (key: Props["active"]) => (active === key ? "page" : undefined);
---

<div class="nav-bar">
  <div class="container">
    <nav class="navbar navbar-expand-md bg-dark navbar-dark">
      <button
        type="button"
        class="navbar-toggler ml-auto"
        data-nav-toggle
        aria-controls="navbarCollapse"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse">
        <div class="navbar-nav mr-auto">
          <a href="/" class={cls("home")} aria-current={current("home")}>Home</a>
          <a href="/library/" class={cls("library")} aria-current={current("library")}>Library</a>
          <a href="/contact/" class={cls("contact")} aria-current={current("contact")}>Contact</a>
        </div>
        <div class="social ml-auto">
          <a href="https://www.instagram.com/impactchurch/" target="_blank" rel="noopener noreferrer" aria-label="Instagram (opens in a new tab)"><i class="fab fa-instagram" aria-hidden="true"></i></a>
          <a href="https://www.youtube.com/user/Impactchurchaz" target="_blank" rel="noopener noreferrer" aria-label="YouTube (opens in a new tab)"><i class="fab fa-youtube" aria-hidden="true"></i></a>
          <a href="https://www.facebook.com/ImpactChurchScottsdale/" target="_blank" rel="noopener noreferrer" aria-label="Facebook (opens in a new tab)"><i class="fab fa-facebook-f" aria-hidden="true"></i></a>
        </div>
      </div>
    </nav>
  </div>
</div>
